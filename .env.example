# ---------------------------------------------------------------
#  Copy to .env.local (or add in Vercel → Settings → Environment
#  Variables). Anything left blank is simply switched off.
# ---------------------------------------------------------------

# Existing
NEXT_PUBLIC_SITE_URL=https://theprofessionals.network
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_PAYMENT_BASE_URL=

# Meta Pixel (defaults to the pixel already on the site)
NEXT_PUBLIC_META_PIXEL_ID=1350131159900260
# Meta Conversions API (server-side Purchase, app/api/meta/purchase/route.js).
# Production only, never commit it. Events Manager → pixel → Settings → Conversions API → Generate access token.
META_CAPI_TOKEN=
# Optional: code from Events Manager → Test events, while testing. Remove after.
META_TEST_EVENT_CODE=

# LinkedIn Insight Tag (defaults to the tag already on the site)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=10536265
# Conversion ids from Campaign Manager → Conversion tracking (method: Insight Tag, event-specific)
NEXT_PUBLIC_LINKEDIN_CONVERSION_CHECKOUT=
NEXT_PUBLIC_LINKEDIN_CONVERSION_PURCHASE=
NEXT_PUBLIC_LINKEDIN_CONVERSION_LEAD=

# HubSpot — Hub ID from Settings → Tracking & Analytics → Tracking code
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# na1 (default) or eu1
NEXT_PUBLIC_HUBSPOT_REGION=na1
# Form GUIDs (Marketing → Forms → open the form → the long id in the URL). Fields per form: TRACKING.md
NEXT_PUBLIC_HUBSPOT_FORM_CHECKOUT=
NEXT_PUBLIC_HUBSPOT_FORM_PURCHASE=
NEXT_PUBLIC_HUBSPOT_FORM_PREVIEW=
NEXT_PUBLIC_HUBSPOT_FORM_PROFILE=

# Optional: TPN backend endpoint that saves the post-payment details (address etc.)
NEXT_PUBLIC_PROFILE_UPDATE_URL=
